# ==============================================================================
# DATABASE (PostgreSQL - Supabase / Neon / Railway)
# ==============================================================================
# Connection pooled URL (e.g. Supabase port 6543 / PgBouncer or Neon pooler)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations & schema push (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# ADMIN CMS CREDENTIALS & SECURITY
# ==============================================================================
# Admin Login Email for /admin
ADMIN_EMAIL="dagmayalew489@gmail.com"

# Admin Login Password for /admin
ADMIN_PASSWORD="change_this_to_a_secure_password"

# Session HMAC signing secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-random-key-with-at-least-32-characters"

# ==============================================================================
# GITHUB OAUTH (OPTIONAL - For 1-Click GitHub Admin Login)
# ==============================================================================
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
ADMIN_GITHUB_USERNAME="dagmayalew"

# ==============================================================================
# APP SETTINGS
# ==============================================================================
NODE_ENV="production"
