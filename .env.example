# ==========================================
# 🌟 Dagmay Ayalew Portfolio Environment Variables
# ==========================================

# Database Connection (Supabase PostgreSQL or Local PostgreSQL)
# For Supabase with Connection Pooling (Transaction mode):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# For Supabase Direct Connection (Session mode for migrations):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# NextAuth / Auth.js Configuration
# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET="portfolio-dagm-ayalew-super-secret-key-change-me"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App Credentials (for Admin Login)
# Create at https://github.com/settings/developers
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"

# Admin Access Control (GitHub username or Admin email authorized to access /admin)
ADMIN_GITHUB_USERNAME="dagmayalew"
ADMIN_EMAIL="dagmayalew@gmail.com"

# Optional Email Notification (Resend - https://resend.com)
RESEND_API_KEY=""
CONTACT_RECEIVER_EMAIL="dagmayalew@gmail.com"
